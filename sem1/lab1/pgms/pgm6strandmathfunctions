<html>
<head>
<title> string and math functions</title>
</head>
<body>
<h1>javascript string and math functions</h1>
<script>
let s="Hypertext Markup Language";
document.write("Length:"+s.length+"<br>");
document.write("uppercase:"+ s.toUpperCase()+ "<br>");
document.write("lowercase:"+s.toLowerCase()+ "<br>");
document.write("character:"+s.charAt(0)+"<br>");

document.write("squareroot:"+Math.sqrt(25)+"<br>");
document.write("round:"+Math.round(4.6)+"<br>");
document.write("maximum:"+Math.max(10,20)+"<br>");
document.write("minimum:"+Math.min(10,20)+"<br>");
</script>
</body>
</html>
